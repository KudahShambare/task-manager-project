{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Management SaaS API",
    "version": "1.0.0",
    "description": "JSON entry point for the OpenAPI contract. The full maintained contract is docs/openapi.yaml."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development"
    },
    {
      "url": "https://task-manager-saas.herokuapp.com/api",
      "description": "Production PaaS URL placeholder"
    }
  ],
  "paths": {
    "/auth/register": { "$ref": "./docs/openapi.yaml#/paths/~1auth~1register" },
    "/auth/login": { "$ref": "./docs/openapi.yaml#/paths/~1auth~1login" },
    "/auth/refresh": { "$ref": "./docs/openapi.yaml#/paths/~1auth~1refresh" },
    "/auth/logout": { "$ref": "./docs/openapi.yaml#/paths/~1auth~1logout" },
    "/users": { "$ref": "./docs/openapi.yaml#/paths/~1users" },
    "/projects": { "$ref": "./docs/openapi.yaml#/paths/~1projects" },
    "/projects/{projectId}": { "$ref": "./docs/openapi.yaml#/paths/~1projects~1{projectId}" },
    "/projects/{projectId}/members": { "$ref": "./docs/openapi.yaml#/paths/~1projects~1{projectId}~1members" },
    "/projects/{projectId}/members/{userId}": { "$ref": "./docs/openapi.yaml#/paths/~1projects~1{projectId}~1members~1{userId}" },
    "/projects/{projectId}/tasks": { "$ref": "./docs/openapi.yaml#/paths/~1projects~1{projectId}~1tasks" },
    "/tasks/{taskId}": { "$ref": "./docs/openapi.yaml#/paths/~1tasks~1{taskId}" },
    "/tasks/{taskId}/status": { "$ref": "./docs/openapi.yaml#/paths/~1tasks~1{taskId}~1status" },
    "/tasks/{taskId}/status/stream": { "$ref": "./docs/openapi.yaml#/paths/~1tasks~1{taskId}~1status~1stream" }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
